Variable Naming Rules
✅ সঠিক নাম
student_name = "Rahim"
studentAge = 20
total_marks = 500
price1 = 100

❌ ভুল নাম
1name = "Rahim"      # সংখ্যা দিয়ে শুরু করা যাবে না
student-name = "Rahim"  # '-' ব্যবহার করা যাবে না
class = "CSE"        # Reserved keyword
